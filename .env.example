# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://dca:dca@localhost:5432/dca

# Internal API (bot/dashboard -> api). Generate with: openssl rand -hex 32
API_URL=http://127.0.0.1:4000
API_HOST=127.0.0.1
API_PORT=4000
INTERNAL_API_TOKEN=

# Discord (bot + slash commands)
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_CREATE_JOB_CHANNEL_ID=
DISCORD_RESPONSES_FORUM_ID=
# Comma-separated Discord user / role IDs allowed to use the bot
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=

# GitHub bot account (collaborator on target repos). No `workflow` scope.
GITHUB_BOT_TOKEN=
GITHUB_BOT_LOGIN=

# LLM providers (configure at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MONTHLY_LLM_CAP_USD=10
# Optional per-command model overrides (<anthropic|openai|openrouter>:<model-id>)
# MODEL_RUNTEST=anthropic:claude-haiku-4-5
# MODEL_RUNTEST_FALLBACK=
# MODEL_BUGREPORT=anthropic:claude-sonnet-5
# MODEL_TASK=anthropic:claude-sonnet-5

# Production only (VPS): see docs/DEPLOY-ORACLE.md
# DOMAIN=agent.example.com
# ACME_EMAIL=you@example.com
# POSTGRES_PASSWORD=            # openssl rand -hex 24
# BACKUP_PAR_URL=               # Oracle Object Storage pre-authenticated request (optional)

# Worker / sandbox
WORKER_CONCURRENCY=2
SANDBOX_PROVIDER=docker
SANDBOX_RUNTIME=runc
# Created by `pnpm infra:up`; sandboxes reach the internet only through the allowlisting proxy.
SANDBOX_NETWORK=dca_sandbox
SANDBOX_PROXY_URL=http://egress-proxy:3128
SANDBOX_IMAGE_NODE=dca-sandbox-node:latest
SANDBOX_IMAGE_PYTHON=dca-sandbox-python:latest
# Per-sandbox limits. On a 2-core / 12 GB VPS use SANDBOX_CPUS=1 with WORKER_CONCURRENCY=2.
SANDBOX_CPUS=2
SANDBOX_MEMORY_MB=2048
ATTACHMENTS_DIR=./data/attachments
WORKSPACES_DIR=./data/workspaces
RETENTION_DAYS=30

# Dashboard
DISCORD_OAUTH_CLIENT_SECRET=
DASHBOARD_URL=http://localhost:3000
SESSION_SECRET=
# Built UI served by the API in production (relative to the repo root)
DASHBOARD_DIST=./apps/dashboard/dist
